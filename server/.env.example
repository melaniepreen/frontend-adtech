# Server
PORT=8787
# comma-separated list of origins allowed to call this API
CORS_ORIGIN=*

# --- Claude (optional) ---
# If set, the briefing copy is polished by Claude inside the Overmind span.
# Omit to skip the draft step and send the dashboard-generated text as-is.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# --- Mail provider (optional, SMTP) ---
# If omitted, sends are SIMULATED (no email leaves the box) so dev works offline.
# Works with any SMTP provider — Resend, SES, Postmark, Mailgun, Gmail app pw…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SIGNAL <noreply@signal.app>

# --- Overmind (optional) ---
# Plug the real SDK in lib/overmind.js; without it a local tracer is used.
OVERMIND_API_KEY=
OVERMIND_PROJECT=signal
